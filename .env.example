# Copy to .env.local and fill in. Never commit .env.local.

# ORDS REST base path (see docs/03_ords_rest_contract.md)
ORDS_BASE_URL=http://<host>:8585/ords/<schema>

# NextAuth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Oracle direct connection. Used only by the auth path, which reads
# app_user.password_hash so bcrypt verification happens in Node, never in PL/SQL.
# Everything else goes through ORDS.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=<host>:<port>/<service>
